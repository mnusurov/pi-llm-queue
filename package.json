{
  "name": "pi-llm-queue",
  "version": "0.1.0",
  "description": "Pi extension + local daemon that serialises LLM access to protect KV-cache warmth",
  "type": "module",
  "main": "./src/index.ts",
  "keywords": [
    "pi-package",
    "pi",
    "llm",
    "kv-cache",
    "queue"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "bin": {
    "pi-llm-queue-daemon": "./src/daemon/daemon.js"
  },
  "files": [
    "src",
    "docs",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-timeout=30000 \"test/*.test.ts\""
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
